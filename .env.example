# Deploy Firestore/Storage/Hosting: ejecutá siempre desde la raíz del monorepo (carpeta Morning/), no desde mi-catalogo/:
#   firebase deploy --only firestore,storage --config firebase.mi-catalogo.json --project mi-catalogo-de61a
# O: npm run deploy:mi-catalogo
#
# Mismo proyecto Firebase que Morning o uno dedicado (recomendado SaaS).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Región donde desplegás Cloud Functions (misma que en Firebase Console → Functions).
# Sin esto, el SDK usa la región por defecto del proyecto (a veces us-central1).
# VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Legado: el panel súper admin usa solo isSuperAdmin: true en mc_users/{uid} (ignorar esta clave en la app).
# VITE_MC_SUPERADMIN_EMAILS=

# OnePay: pagos reales en el checkout. Requiere desplegar funciones (incl. mcOnepayStartCatalogCheckout,
# mcOnepayCatalogWebhook, mcOnepayCheckoutStatus, vinculación en Cuenta):
#   cd functions && npm install && npm run build && cd .. && firebase deploy --only functions
# API cobros: https://docs.onepay.la/client/payments/index · Webhooks: https://docs.onepay.la/client/webhooks/index
# Crear empresas (KYB) para vendedores — Callable `mcOnepaySubmitCompanyKyb`:
# echo -n 'sk_live_xxx' | firebase functions:secrets:set ONEPAY_PLATFORM_SK
# (La app de vendedor NO envía esta clave; solo el backend.)
# Versión de términos en código: `mc-2026-05` (src/lib/onepayKyb.ts y functions/src/index.ts).
