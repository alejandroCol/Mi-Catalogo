rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function role() {
      return userDoc().data.role;
    }
    function isAdmin() {
      return signedIn() && role() == 'administrador';
    }
    function isVendedora() {
      return signedIn() && role() == 'vendedora';
    }
    function isProveedor() {
      return signedIn() && role() == 'proveedor';
    }
    function mySede() {
      return userDoc().data.sedeId;
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      /** Auto-registro: solo el propio uid y email del token. */
      allow create: if (signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.auth.token.email != null
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role in ['administrador', 'vendedora', 'proveedor']
          && request.resource.data.activo == true
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int)
        /** Admin: alta de otro usuario (Auth se crea desde la app con app secundaria). */
        || (isAdmin()
          && request.resource.data.uid == uid
          && request.resource.data.email is string
          && request.resource.data.displayName is string
          && request.resource.data.role in ['administrador', 'vendedora', 'proveedor']
          && request.resource.data.activo is bool
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sedes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /proveedores/{id} {
      allow read: if isAdmin() || (isProveedor() && userDoc().data.proveedorId == id);
      /** Temporal: registro proveedor desde la app (solo alta inicial controlada) */
      allow create: if signedIn()
        && request.resource.data.nombre is string
        && request.resource.data.saldoCreditoPendiente == 0
        && request.resource.data.activo == true
        && request.resource.data.createdAt is int;
      allow update, delete: if isAdmin();
    }

    match /pagos_proveedor/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /telas/{id} {
      allow read, write: if isAdmin();
    }

    match /config/{id} {
      allow read: if id == 'catalogo_publico';
      allow write: if isAdmin();
    }

    match /referencias/{id} {
      allow read: if signedIn() || resource.data.activa == true;
      allow write: if isAdmin();
    }

    match /sublimados/{id} {
      allow read: if signedIn() || resource.data.activo == true;
      allow write: if isAdmin();
    }

    match /insumos/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /movimientos_insumo/{id} {
      allow read, write: if isAdmin();
    }

    match /talleres_confeccion/{id} {
      allow read, write: if isAdmin();
    }

    match /lotes_produccion/{id} {
      allow read, write: if isAdmin();
    }

    match /stock/{id} {
      allow read: if signedIn() || (exists(/databases/$(database)/documents/config/catalogo_publico) &&
        resource.data.ubicacionId == get(/databases/$(database)/documents/config/catalogo_publico).data.sedeStockId);
      allow create, update: if isAdmin() || (isVendedora() && request.resource.data.ubicacionId == mySede());
      allow delete: if isAdmin();
    }

    match /traslados/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ventas/{id} {
      allow read: if isAdmin() || (isVendedora() && resource.data.sedeId == mySede());
      allow create: if isVendedora() && request.resource.data.sedeId == mySede();
      allow update, delete: if isAdmin();
    }

    match /caja_diaria/{id} {
      allow read: if isAdmin() || (isVendedora() && resource.data.vendedoraUid == request.auth.uid);
      allow create, update: if isVendedora() && request.resource.data.vendedoraUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /turnos_vendedora/{id} {
      allow read: if isAdmin()
        || (isVendedora() && resource.data.vendedoraUid == request.auth.uid);
      allow create: if isVendedora()
        && request.resource.data.sedeId == mySede()
        && request.resource.data.vendedoraUid == request.auth.uid
        && request.resource.data.vendedoraNombre is string
        && request.resource.data.inicioAt is int
        && request.resource.data.estado == 'abierto'
        && request.resource.data.updatedAt is int
        && (!('finAt' in request.resource.data) || request.resource.data.finAt == null);
      allow update: if isVendedora()
        && resource.data.vendedoraUid == request.auth.uid
        && resource.data.estado == 'abierto'
        && request.resource.data.estado == 'cerrado'
        && request.resource.data.finAt is int
        && request.resource.data.finAt >= resource.data.inicioAt
        && request.resource.data.sedeId == resource.data.sedeId
        && request.resource.data.vendedoraUid == resource.data.vendedoraUid
        && request.resource.data.vendedoraNombre == resource.data.vendedoraNombre
        && request.resource.data.inicioAt == resource.data.inicioAt
        && request.resource.data.updatedAt is int;
      allow delete: if isAdmin();
    }

    match /devoluciones/{id} {
      allow read: if isAdmin() || (isVendedora() && resource.data.sedeId == mySede());
      allow create: if isVendedora() && request.resource.data.sedeId == mySede();
      allow update, delete: if isAdmin();
    }

    match /movimientos_tela/{id} {
      allow read, write: if isAdmin();
    }

    match /compras_insumo/{id} {
      allow read, write: if isAdmin();
    }

    match /inventario_cierres/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    /** ——— Mi Catálogo (SaaS multi-tienda, prefijo mc_) ——— */
    function mcSignedIn() {
      return request.auth != null;
    }
    function mcUserPath() {
      return /databases/$(database)/documents/mc_users/$(request.auth.uid);
    }
    function mcUserData() {
      return get(mcUserPath()).data;
    }
    function mcIsSuperAdmin() {
      return mcSignedIn()
        && exists(mcUserPath())
        && (
          mcUserData().isSuperAdmin == true
          || mcUserData().isSuperAdmin == 1
        );
    }
    /** Súper admin viendo otra tienda (claim del callable mcStartStoreImpersonation). */
    function mcImpersonatingTenant(tid) {
      return mcSignedIn()
        && request.auth.token.keys().hasAny(['mcImpersonateTenantId'])
        && request.auth.token.mcImpersonateTenantId == tid;
    }
    function mcIsSalesRep() {
      return mcSignedIn()
        && exists(mcUserPath())
        && mcUserData().role == 'sales_rep'
        && (!('active' in mcUserData()) || mcUserData().active != false);
    }
    function mcIsPosVendor() {
      return mcSignedIn()
        && exists(mcUserPath())
        && mcUserData().role == 'pos_vendor'
        && (!('active' in mcUserData()) || mcUserData().active != false);
    }
    function mcPosSedeId() {
      return mcUserData().posSedeId;
    }
    function mcIsTenantOwner(tid) {
      return mcSignedIn()
        && exists(/databases/$(database)/documents/mc_tenants/$(tid))
        && get(/databases/$(database)/documents/mc_tenants/$(tid)).data.ownerUid == request.auth.uid;
    }
    function mcPosCanWriteVenta(tid) {
      return mcIsPosVendor()
        && mcUserData().tenantId == tid
        && request.resource.data.sedeId == mcPosSedeId()
        && request.resource.data.vendedorUid == request.auth.uid
        || (
          mcIsTenantOwner(tid)
          && request.resource.data.vendedorUid == request.auth.uid
        )
        || (
          mcImpersonatingTenant(tid)
          && request.resource.data.vendedorUid == request.auth.uid
        );
    }
    function mcPosCanWriteCajaTurno(tid) {
      return mcIsPosVendor()
        && mcUserData().tenantId == tid
        && request.resource.data.vendedorUid == request.auth.uid
        && request.resource.data.sedeId == mcPosSedeId()
        || (
          mcIsTenantOwner(tid)
          && request.resource.data.vendedorUid == request.auth.uid
        )
        || (
          mcImpersonatingTenant(tid)
          && request.resource.data.vendedorUid == request.auth.uid
        );
    }
    function mcPosOwnerOrVendor(tid) {
      return mcBelongsToTenant(tid)
        && (
          mcIsTenantOwner(tid)
          || mcIsPosVendor()
          || mcImpersonatingTenant(tid)
        );
    }
    function mcSuperAdminPosDemoSeedWrite() {
      return mcIsSuperAdmin()
        && request.resource.data.mcPosDemoSeed == true;
    }
    function mcSuperAdminPosDemoSeedDelete() {
      return mcIsSuperAdmin()
        && resource.data.get('mcPosDemoSeed', false) == true;
    }
    function mcTenantIsExpert(data) {
      return 'billingPlan' in data && data.billingPlan == 'expert';
    }
    function mcTenantIsMaster(data) {
      return 'billingPlan' in data && data.billingPlan == 'master';
    }
    function mcTenantIsPaidPlan(data) {
      return mcTenantIsExpert(data) || mcTenantIsMaster(data);
    }
    function mcPlanFreeMaxProductos() {
      return exists(/databases/$(database)/documents/mc_platform/settings)
        && get(/databases/$(database)/documents/mc_platform/settings).data.planFreeMaxProductos is int
        ? get(/databases/$(database)/documents/mc_platform/settings).data.planFreeMaxProductos
        : 20;
    }
    function mcPlanExpertMaxProductos() {
      return exists(/databases/$(database)/documents/mc_platform/settings)
        && get(/databases/$(database)/documents/mc_platform/settings).data.planExpertMaxProductos is int
        ? get(/databases/$(database)/documents/mc_platform/settings).data.planExpertMaxProductos
        : 500;
    }
    function mcTenantProductCount(data) {
      return 'productCount' in data && data.productCount is number ? data.productCount : 0;
    }
    function mcProductCreateAllowed(tid) {
      let tenant = get(/databases/$(database)/documents/mc_tenants/$(tid)).data;
      let count = mcTenantProductCount(tenant);
      return count < mcPlanExpertMaxProductos();
    }
    function mcTenantProductCountPatchOk() {
      return request.resource.data.productCount is number
        && request.resource.data.productCount >= 0
        && (
          !('productCount' in resource.data)
          || request.resource.data.productCount == resource.data.productCount + 1
          || request.resource.data.productCount == resource.data.productCount - 1
        );
    }
    /** Dueño o impersonación: solo incrementar/decrementar contador de productos. */
    function mcTenantOwnerProductCountPatch() {
      return mcSignedIn()
        && request.auth.uid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['productCount'])
        && mcTenantProductCountPatchOk();
    }
    /** Campos que el dueño puede actualizar desde Cuenta (plan Free). */
    function mcTenantOwnerPatchKeysFree() {
      return [
        'nombreTienda',
        'whatsappNumero',
        'mensajeIntro',
        'salesSummaryPeriod',
        'envioEstimadoCop',
        'envioEstimadoEtiqueta',
        'envioPorCiudad',
        'envioUsarTarifasMicatalogo',
        'envioGratisDesdeCop',
        'envioCotizarAutomatico',
        'envioOrigenDepartamento',
        'envioOrigenCiudad',
        'envioOrigenDireccion',
        'envioOrigenTelefono',
        'envioEmpaquePesoKg',
        'envioEmpaqueLargoCm',
        'envioEmpaqueAnchoCm',
        'envioEmpaqueAltoCm',
        'envioTransportadoraFavorita',
        'cuponesCatalogo',
        'catalogDescuentosTab',
        'politicasEnvios',
        'politicasPagos',
        'politicasCambios',
        'checkoutVentasModo',
        'onboardingSharePromptSeenAt',
        'catalogTheme',
        'storeLogoUrl',
        'seasonBanner',
        'posSedeBodegaId',
        'posBridgeInstallerUrl',
      ];
    }
    /** Campos de facturación inmutables en patches del dueño (free implícito = explícito). */
    function mcTenantOwnerBillingUnchanged() {
      let r = resource.data;
      let n = request.resource.data;
      let rPlan = ('billingPlan' in r) ? r.billingPlan : 'free';
      let nPlan = ('billingPlan' in n) ? n.billingPlan : 'free';
      return rPlan == nPlan
        && (
          (!('subscriptionEndsAt' in r) && !('subscriptionEndsAt' in n))
          || (
            r.subscriptionEndsAt is number
            && n.subscriptionEndsAt is number
            && r.subscriptionEndsAt == n.subscriptionEndsAt
          )
          || (
            r.subscriptionEndsAt is timestamp
            && n.subscriptionEndsAt is timestamp
            && r.subscriptionEndsAt == n.subscriptionEndsAt
          )
        );
    }
    function mcTenantCreatedAtUnchanged() {
      return resource.data.createdAt is number
        && request.resource.data.createdAt is number
        && resource.data.createdAt == request.resource.data.createdAt;
    }
    function mcBelongsToTenant(tid) {
      return mcSignedIn()
        && exists(mcUserPath())
        && (
          mcUserData().tenantId == tid
          || mcIsSuperAdmin()
          || mcImpersonatingTenant(tid)
        );
    }
    /** exists() primero: un get() a doc inexistente tumba toda la condición de la regla. */
    function mcTenantIsFreePlan(data) {
      return !('billingPlan' in data) || data.billingPlan == 'free';
    }
    /** subscriptionEndsAt es ms (number). En Firestore puede almacenarse como double; is int fallaba → permission-denied en catálogo público. */
    function mcTenantSubscriptionEndsOk(data) {
      return (data.subscriptionEndsAt is number && data.subscriptionEndsAt > request.time.toMillis())
        || (data.subscriptionEndsAt is timestamp && data.subscriptionEndsAt > request.time);
    }
    /** Plan Free: acceso sin vencimiento. Expert: requiere subscriptionEndsAt vigente. */
    function mcTenantSubActive(tid) {
      let data = get(/databases/$(database)/documents/mc_tenants/$(tid)).data;
      return exists(/databases/$(database)/documents/mc_tenants/$(tid))
        && (mcTenantIsFreePlan(data) || mcTenantSubscriptionEndsOk(data));
    }
    function mcTenantExpertPublishActive(data) {
      return mcTenantIsPaidPlan(data)
        && (
          mcTenantSubscriptionEndsOk(data)
          || (
            data.billingSubStatus == 'past_due'
            && data.billingGraceUntilMs is number
            && data.billingGraceUntilMs > request.time.toMillis()
          )
        );
    }
    /** Tiendas pre-migración sin campo catalogPublished. */
    function mcTenantImplicitLegacy(data) {
      return !('catalogPublished' in data)
        && (!('catalogPublishGrandfathered' in data) || data.catalogPublishGrandfathered != false);
    }
    /** Catálogo accesible para clientes anónimos. */
    function mcTenantCatalogPublic(tid) {
      let data = get(/databases/$(database)/documents/mc_tenants/$(tid)).data;
      return exists(/databases/$(database)/documents/mc_tenants/$(tid))
        && (
          data.catalogPublishGrandfathered == true
          || (mcTenantImplicitLegacy(data) && mcTenantSubActive(tid))
          || (
            data.catalogPublished == true
            && mcTenantExpertPublishActive(data)
          )
        );
    }
    /** Versión vigente de T&C plataforma (default = src/lib/platformTerms.ts). */
    function mcCurrentPlatformTermsVersion() {
      return (
        exists(/databases/$(database)/documents/mc_platform/settings)
        && get(/databases/$(database)/documents/mc_platform/settings).data.keys().hasAny(['platformTermsVersion'])
        && get(/databases/$(database)/documents/mc_platform/settings).data.platformTermsVersion is string
        && get(/databases/$(database)/documents/mc_platform/settings).data.platformTermsVersion.size() > 0
      )
        ? get(/databases/$(database)/documents/mc_platform/settings).data.platformTermsVersion
        : '2026-05-23';
    }

    function mcCanTenantOwnerReadPosVendor() {
      return resource.data.role == 'pos_vendor'
        && resource.data.tenantId is string
        && mcIsTenantOwner(resource.data.tenantId);
    }

    match /mc_users/{uid} {
      allow read: if mcSignedIn() && (
        request.auth.uid == uid
        || mcIsSuperAdmin()
        || mcCanTenantOwnerReadPosVendor()
      );
      allow create: if mcSignedIn()
        && request.auth.uid == uid
        && request.resource.data.tenantId is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.isSuperAdmin == false
        && request.resource.data.createdAt is int;
      allow update: if mcIsSuperAdmin()
        || (request.auth.uid == uid
          && resource.data.isSuperAdmin == request.resource.data.isSuperAdmin
          && resource.data.tenantId == request.resource.data.tenantId
          && resource.data.email == request.resource.data.email);
      allow delete: if false;
    }

    match /mc_tenants/{tid} {
      allow read: if mcIsSuperAdmin()
        || mcIsSalesRep()
        || mcTenantCatalogPublic(tid)
        || (mcSignedIn() && mcBelongsToTenant(tid));
      allow create: if mcSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.slug is string
        && request.resource.data.nombreTienda is string
        && request.resource.data.whatsappNumero is string
        && request.resource.data.createdAt is number
        && (!('billingPlan' in request.resource.data) || request.resource.data.billingPlan == 'free')
        && (!('catalogPublished' in request.resource.data) || request.resource.data.catalogPublished == false)
        && (!('catalogPublishGrandfathered' in request.resource.data)
          || request.resource.data.catalogPublishGrandfathered == false)
        && (!('subscriptionEndsAt' in request.resource.data)
          || (request.resource.data.subscriptionEndsAt is number
            && request.resource.data.subscriptionEndsAt > request.time.toMillis()))
        && request.resource.data.platformTermsAcceptedAt is number
        && request.resource.data.platformTermsVersion is string
        && request.resource.data.platformTermsVersion == mcCurrentPlatformTermsVersion()
        && request.resource.data.platformTermsAcceptedByUid == request.auth.uid
        && request.resource.data.platformTermsAcceptedByEmail == request.auth.token.email
        && request.resource.data.platformTermsContentHash is string
        && request.resource.data.platformTermsContentHash.size() > 0
        && (!('platformTermsUserAgent' in request.resource.data)
          || request.resource.data.platformTermsUserAgent is string);
      allow update: if mcIsSuperAdmin()
        || mcTenantOwnerProductCountPatch()
        || (
          mcSignedIn()
          && request.auth.uid == resource.data.ownerUid
          && resource.data.ownerUid == request.resource.data.ownerUid
          && resource.data.slug == request.resource.data.slug
          && mcTenantCreatedAtUnchanged()
          && (
            /** Upgrade demo Free → Expert (pasarela mock; límite ~400 días). */
            (
              resource.data.billingPlan == 'free'
              && request.resource.data.billingPlan == 'expert'
              && request.resource.data.subscriptionEndsAt is number
              && request.resource.data.subscriptionEndsAt > request.time.toMillis()
              && request.resource.data.subscriptionEndsAt
                < request.time.toMillis() + 10 * 365 * 24 * 60 * 60 * 1000
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['billingPlan', 'subscriptionEndsAt'])
            )
            /** Dueño: configuración de tienda (tema, logo, checkout, envíos, etc.). */
            || (
              mcTenantOwnerBillingUnchanged()
              && (!('salesSummaryPeriod' in request.resource.data)
                || request.resource.data.salesSummaryPeriod in ['week', 'fortnight'])
              && (!('checkoutVentasModo' in request.resource.data)
                || request.resource.data.checkoutVentasModo in ['pasarela', 'whatsapp', 'pasarela_micatalogo'])
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(mcTenantOwnerPatchKeysFree())
            )
            /** Contador de productos: ver mcTenantOwnerProductCountPatch() arriba. */
          )
        );
      allow delete: if false;
    }

    function mcStoreSlugReserved(slug) {
      return slug == 'www' || slug == 'app' || slug == 'api' || slug == 'admin'
        || slug == 'mail' || slug == 'smtp' || slug == 'cdn' || slug == 'static'
        || slug == 'assets' || slug == 'staging' || slug == 'dev' || slug == 'test'
        || slug == 'beta' || slug == 'demo' || slug == 'help' || slug == 'support'
        || slug == 'status' || slug == 'blog' || slug == 'docs' || slug == 'superadmin'
        || slug == 'login' || slug == 'registro' || slug == 'firebase' || slug == 'auth'
        || slug == 'ftp' || slug == 'ns' || slug == 'mx' || slug == 'c';
    }

    match /mc_slugs/{slug} {
      /** get: registro puede leer slugs libres/inactivos; catálogo público solo slugs activos. */
      allow get: if !exists(/databases/$(database)/documents/mc_slugs/$(slug))
        || resource.data.active == true
        || resource.data.active == false;
      allow list: if false;
      allow create: if mcSignedIn()
        && !mcStoreSlugReserved(slug)
        && request.resource.data.active == true
        && request.resource.data.tenantId is string
        && request.resource.data.updatedAt is int
        && get(/databases/$(database)/documents/mc_tenants/$(request.resource.data.tenantId)).data.ownerUid
          == request.auth.uid;
      allow update: if mcSignedIn()
        && mcBelongsToTenant(resource.data.tenantId)
        && request.auth.uid
          == get(/databases/$(database)/documents/mc_tenants/$(resource.data.tenantId)).data.ownerUid;
      allow delete: if false;
    }

    /** Credenciales OnePay: solo backend (Admin SDK). */
    match /mc_tenants/{tid}/private_onepay/{doc} {
      allow read, write: if false;
    }
    match /mc_tenants/{tid}/onpay_idem/{id} {
      allow read, write: if false;
    }

    /** Registro inmutable de aceptación de T&C plataforma. */
    match /mc_tenants/{tid}/legal_acceptances/{version} {
      allow read: if mcIsSuperAdmin()
        || (mcSignedIn() && mcBelongsToTenant(tid));
      allow create: if mcSignedIn()
        && request.auth.uid
          == get(/databases/$(database)/documents/mc_tenants/$(tid)).data.ownerUid
        && request.resource.data.acceptedAt is number
        && request.resource.data.termsVersion is string
        && request.resource.data.termsVersion == version
        && request.resource.data.termsVersion == mcCurrentPlatformTermsVersion()
        && request.resource.data.termsContentHash is string
        && request.resource.data.acceptedByUid == request.auth.uid
        && request.resource.data.acceptedByEmail == request.auth.token.email
        && request.resource.data.context == 'registration'
        && (!('userAgent' in request.resource.data) || request.resource.data.userAgent is string);
      allow update, delete: if false;
    }

    /** Enrutamiento y deduplicación de webhooks OnePay: solo Admin / Functions. */
    match /mc_onpay_webhook_routes/{key} {
      allow read, write: if false;
    }
    match /mc_onpay_event_log/{id} {
      allow read, write: if false;
    }

    /** Ajustes de plataforma (catálogo): lectura pública mínima para checkout. */
    match /mc_platform/settings {
      allow get: if true;
      allow list: if false;
      allow write: if mcIsSuperAdmin();
    }

    match /mc_platform/credentials_onepay {
      allow read, write: if false;
    }

    match /mc_billing_discount_codes/{codeId} {
      allow read: if mcIsSuperAdmin();
      allow write: if mcIsSuperAdmin();
    }

    match /mc_tutorial_sections/{sectionId} {
      allow read: if mcSignedIn();
      allow write: if mcIsSuperAdmin();

      match /tutorials/{tutorialId} {
        allow read: if mcSignedIn();
        allow write: if mcIsSuperAdmin();
      }
    }

    /** Talleres formativos: lectura pública solo si están activos; inscripciones vía Cloud Functions. */
    match /mc_talleres/{slug} {
      allow get: if resource.data.active == true;
      allow list: if mcIsSuperAdmin();
      allow create, update, delete: if mcIsSuperAdmin();

      match /registrations/{regId} {
        allow read: if mcIsSuperAdmin();
        allow write: if false;
      }
    }

    match /mc_billing_checkouts/{checkoutId} {
      allow read, write: if false;
    }

    match /mc_tenants/{tid}/billingSubscription/{docId} {
      allow read: if mcSignedIn() && mcBelongsToTenant(tid);
      allow write: if false;
    }

    match /mc_tenants/{tid}/analytics_daily/{dateKey} {
      allow read: if mcBelongsToTenant(tid);
      allow write: if false;
    }

    match /mc_tenants/{tid}/analytics_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /mc_tenants/{tid}/analytics_products/{productId} {
      allow read: if mcBelongsToTenant(tid);
      allow write: if false;
    }

    match /mc_tenants/{tid}/analytics_product_daily/{docId} {
      allow read: if mcBelongsToTenant(tid);
      allow write: if false;
    }

    match /mc_tenants/{tid}/productos/{pid} {
      allow read: if mcIsSuperAdmin()
        || (resource.data.activo == true
          && resource.data.enCatalogo == true
          && mcTenantCatalogPublic(tid))
        || (mcSignedIn() && mcBelongsToTenant(tid));
      allow create: if mcSignedIn()
        && mcBelongsToTenant(tid)
        && (mcTenantSubActive(tid) || mcIsSuperAdmin())
        && (mcIsSuperAdmin() || mcProductCreateAllowed(tid));
      allow update: if mcSignedIn()
        && mcBelongsToTenant(tid)
        && (mcTenantSubActive(tid) || mcIsSuperAdmin());
      allow delete: if mcSignedIn()
        && mcBelongsToTenant(tid)
        && (mcTenantSubActive(tid) || mcIsSuperAdmin());
    }

    match /mc_tenants/{tid}/categorias/{cid} {
      allow read: if mcIsSuperAdmin()
        || (resource.data.activa == true && mcTenantCatalogPublic(tid))
        || (mcSignedIn() && mcBelongsToTenant(tid));
      allow create, update, delete: if mcSignedIn()
        && mcBelongsToTenant(tid)
        && (mcTenantSubActive(tid) || mcIsSuperAdmin());
    }

    match /mc_tenants/{tid}/pedidos/{pid} {
      allow read: if mcSignedIn() && (mcBelongsToTenant(tid) || mcIsSuperAdmin());
      allow create, update, delete: if mcSignedIn() && mcBelongsToTenant(tid);
    }

    /** Ventas desde el catálogo público (checkout mock). */
    /** Carritos iniciados en checkout (recuperación Expert). */
    match /mc_tenants/{tid}/carritos_iniciados/{cid} {
      allow get: if mcTenantCatalogPublic(tid);
      allow list: if mcSignedIn() && (mcBelongsToTenant(tid) || mcIsSuperAdmin());
      allow create: if mcTenantCatalogPublic(tid)
        && request.resource.data.keys().hasAll([
          'createdAt', 'updatedAt', 'estado', 'lineas', 'subtotalCop', 'sessionToken'
        ])
        && request.resource.data.estado == 'activo'
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.subtotalCop is number
        && request.resource.data.subtotalCop >= 0
        && request.resource.data.lineas is list
        && request.resource.data.lineas.size() > 0
        && request.resource.data.lineas.size() <= 100
        && request.resource.data.sessionToken is string
        && request.resource.data.sessionToken.size() >= 16;
      allow update: if mcTenantCatalogPublic(tid)
        && (
          (
            resource.data.estado == 'activo'
            && request.resource.data.sessionToken == resource.data.sessionToken
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.estado in ['activo', 'comprado', 'recuperado']
            && request.resource.data.updatedAt is int
            && request.resource.data.updatedAt >= resource.data.updatedAt
            && request.resource.data.lineas is list
            && request.resource.data.subtotalCop is number
          )
          || (
            mcSignedIn()
            && mcBelongsToTenant(tid)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.sessionToken == resource.data.sessionToken
          )
        );
      allow delete: if false;
    }

    /** Live accesible por link público (slug activo), sin exigir catálogo publicado. */
    function mcLiveSessionPublicReadable(tid, data) {
      return data.status in ['live', 'ended']
        && (
          (
            'storeSlug' in data
            && data.storeSlug is string
            && data.storeSlug.size() > 0
            && exists(/databases/$(database)/documents/mc_slugs/$(data.storeSlug))
            && get(/databases/$(database)/documents/mc_slugs/$(data.storeSlug)).data.active == true
            && get(/databases/$(database)/documents/mc_slugs/$(data.storeSlug)).data.tenantId == tid
          )
          || (
            mcTenantCatalogPublic(tid)
          )
        );
    }
    function mcLiveSessionPublicById(tid, sid) {
      let path = /databases/$(database)/documents/mc_tenants/$(tid)/live_sessions/$(sid);
      return exists(path)
        && mcLiveSessionPublicReadable(tid, get(path).data);
    }

    match /mc_tenants/{tid}/live_sessions/{sid} {
      allow read: if mcIsSuperAdmin()
        || (mcSignedIn() && mcBelongsToTenant(tid))
        || mcLiveSessionPublicReadable(tid, resource.data);
      allow create, update, delete: if mcSignedIn()
        && mcBelongsToTenant(tid)
        && mcTenantSubActive(tid)
        && mcTenantIsMaster(get(/databases/$(database)/documents/mc_tenants/$(tid)).data);
    }

    match /mc_tenants/{tid}/live_sessions/{sid}/session_products/{pid} {
      allow read: if mcIsSuperAdmin()
        || (mcSignedIn() && mcBelongsToTenant(tid))
        || mcLiveSessionPublicById(tid, sid);
      allow write: if mcSignedIn()
        && mcBelongsToTenant(tid)
        && mcTenantSubActive(tid)
        && mcTenantIsMaster(get(/databases/$(database)/documents/mc_tenants/$(tid)).data);
    }

    match /mc_tenants/{tid}/live_sessions/{sid}/chat/{msgId} {
      allow read: if mcIsSuperAdmin()
        || (mcSignedIn() && mcBelongsToTenant(tid))
        || mcLiveSessionPublicById(tid, sid);
      allow create, update, delete: if false;
    }

    match /mc_tenants/{tid}/live_sessions/{sid}/viewers/{viewerId} {
      allow read: if mcSignedIn() && mcBelongsToTenant(tid);
      allow create: if mcLiveSessionPublicById(tid, sid)
        && get(/databases/$(database)/documents/mc_tenants/$(tid)/live_sessions/$(sid)).data.status == 'live'
        && request.resource.data.keys().hasAll(['joinedAt'])
        && request.resource.data.joinedAt is int;
      allow update, delete: if false;
    }

    match /mc_tenants/{tid}/ordenes_catalogo/{oid} {
      allow create: if mcTenantCatalogPublic(tid)
        && request.resource.data.keys().hasAll([
          'createdAt', 'updatedAt', 'estado', 'lineas', 'totalCop', 'pagoSimulado'
        ])
        && request.resource.data.estado == 'pagado'
        && request.resource.data.pagoSimulado == true
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.totalCop is number
        && request.resource.data.totalCop >= 0
        && request.resource.data.totalCop < 1000000000
        && request.resource.data.lineas is list
        && request.resource.data.lineas.size() > 0
        && request.resource.data.lineas.size() <= 100
        && (!('subtotalCop' in request.resource.data)
          || (request.resource.data.subtotalCop is number
            && request.resource.data.subtotalCop > 0
            && request.resource.data.subtotalCop < 1000000000))
        && (!('envioCop' in request.resource.data)
          || (request.resource.data.envioCop is number
            && request.resource.data.envioCop >= 0
            && request.resource.data.envioCop < 1000000000))
        && (!('descuentoCop' in request.resource.data)
          || (request.resource.data.descuentoCop is number
            && request.resource.data.descuentoCop >= 0
            && request.resource.data.descuentoCop < 1000000000))
        && (!('cuponCodigo' in request.resource.data)
          || request.resource.data.cuponCodigo is string)
        && (!('carritoIniciadoId' in request.resource.data)
          || request.resource.data.carritoIniciadoId is string)
        && (!('envioCiudad' in request.resource.data) || request.resource.data.envioCiudad is string)
        && (!('envioDireccion' in request.resource.data) || request.resource.data.envioDireccion is string)
        && (!('envioReferencia' in request.resource.data) || request.resource.data.envioReferencia is string)
        && (!('envioDepartamento' in request.resource.data) || request.resource.data.envioDepartamento is string)
        && (!('clienteTipoDocumento' in request.resource.data)
          || request.resource.data.clienteTipoDocumento is string)
        && (!('clienteDocumentoNumero' in request.resource.data)
          || request.resource.data.clienteDocumentoNumero is string);
      allow read: if mcSignedIn() && (mcBelongsToTenant(tid) || mcIsSuperAdmin());
      allow update: if mcSignedIn()
        && mcBelongsToTenant(tid)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lineas == resource.data.lineas
        && request.resource.data.totalCop == resource.data.totalCop
        && request.resource.data.pagoSimulado == resource.data.pagoSimulado
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.estado in [
          'esperando_pago',
          'pagado',
          'en_preparacion',
          'listo_envio',
          'enviado',
          'entregado',
          'cancelado'
        ]
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'estado',
            'updatedAt',
            'trackingNumber',
            'trackingImageUrl',
            'seguimientoCompraAt',
            'seguimientoPreparacionAt',
            'seguimientoDespachoAt',
            'seguimientoEntregaAt'
          ]);
      allow delete: if false;
    }

    /** Auditoría de modo soporte (súper admin impersonando tienda). Escritura solo Admin SDK. */
    match /mc_impersonation_sessions/{sessionId} {
      allow read: if mcIsSuperAdmin();
      allow write: if false;
    }

    /** Visitas presenciales registradas por vendedores de campo. */
    match /mc_sales_visits/{visitId} {
      allow read: if mcIsSuperAdmin()
        || (mcIsSalesRep() && resource.data.salesRepUid == request.auth.uid);
      allow create: if mcIsSalesRep()
        && request.resource.data.salesRepUid == request.auth.uid
        && request.resource.data.salesRepName is string
        && request.resource.data.storeName is string
        && request.resource.data.storeName.size() > 0
        && request.resource.data.storeName.size() <= 200
        && request.resource.data.outcome in ['venta_exitosa', 'pendiente', 'rechazo']
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.size() == 10
        && request.resource.data.createdAt is int
        && (
          request.resource.data.outcome != 'rechazo'
          || (
            request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
            && request.resource.data.rejectionReason.size() <= 500
          )
        )
        && (
          !('storeDetail' in request.resource.data)
          || (
            request.resource.data.storeDetail is string
            && request.resource.data.storeDetail.size() <= 500
          )
        )
        && (
          !('tenantId' in request.resource.data)
          || (
            request.resource.data.tenantId is string
            && request.resource.data.tenantId.size() > 0
            && exists(/databases/$(database)/documents/mc_tenants/$(request.resource.data.tenantId))
          )
        )
        && (
          !('tenantSlug' in request.resource.data)
          || (
            request.resource.data.tenantSlug is string
            && request.resource.data.tenantSlug.size() > 0
            && request.resource.data.tenantSlug.size() <= 80
          )
        );
      allow update: if mcIsSalesRep()
        && resource.data.salesRepUid == request.auth.uid
        && request.resource.data.salesRepUid == resource.data.salesRepUid
        && request.resource.data.salesRepName == resource.data.salesRepName
        && request.resource.data.storeName == resource.data.storeName
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.outcome in ['venta_exitosa', 'pendiente', 'rechazo']
        && request.resource.data.updatedAt is int
        && request.resource.data.updates is list
        && request.resource.data.updates.size() > 0
        && request.resource.data.updates.size()
          == (('updates' in resource.data) ? resource.data.updates.size() : 0) + 1
        && (
          !('storeDetail' in request.resource.data)
          || request.resource.data.storeDetail == resource.data.get('storeDetail', null)
        )
        && (
          !('tenantId' in request.resource.data)
          || request.resource.data.tenantId == resource.data.get('tenantId', null)
        )
        && (
          !('tenantSlug' in request.resource.data)
          || request.resource.data.tenantSlug == resource.data.get('tenantSlug', null)
        )
        && (
          request.resource.data.outcome != 'rechazo'
          || (
            request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
            && request.resource.data.rejectionReason.size() <= 500
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['outcome', 'rejectionReason', 'updates', 'updatedAt']);
      allow delete: if false;
    }

    /** Tiendas demo para mostrar a marcas (vendedores leen; súper admin escribe). */
    match /mc_demo_stores/{demoId} {
      allow read: if mcIsSuperAdmin() || mcIsSalesRep();
      allow create, update, delete: if mcIsSuperAdmin();
    }

    /** ——— POS Mi Catálogo (por tenant) ——— */
    match /mc_tenants/{tid}/pos_sedes/{sedeId} {
      allow read: if mcPosOwnerOrVendor(tid) || mcIsSuperAdmin();
      allow create, update: if (mcBelongsToTenant(tid) && mcIsTenantOwner(tid)) || mcSuperAdminPosDemoSeedWrite();
      allow delete: if (mcBelongsToTenant(tid) && mcIsTenantOwner(tid)) || mcSuperAdminPosDemoSeedDelete();
    }

    match /mc_tenants/{tid}/pos_productos/{productoId} {
      allow read: if mcPosOwnerOrVendor(tid) || mcIsSuperAdmin();
      allow create, update: if (mcBelongsToTenant(tid) && (mcIsTenantOwner(tid) || mcImpersonatingTenant(tid))) || mcSuperAdminPosDemoSeedWrite();
      allow delete: if (mcBelongsToTenant(tid) && (mcIsTenantOwner(tid) || mcImpersonatingTenant(tid))) || mcSuperAdminPosDemoSeedDelete();
    }

    match /mc_tenants/{tid}/pos_stock/{stockId} {
      allow read: if mcPosOwnerOrVendor(tid) || mcIsSuperAdmin();
      allow create, update: if mcBelongsToTenant(tid)
        && (
          mcIsTenantOwner(tid)
          || (
            mcIsPosVendor()
            && request.resource.data.sedeId == mcPosSedeId()
          )
          || mcImpersonatingTenant(tid)
        )
        || mcSuperAdminPosDemoSeedWrite();
      allow delete: if (mcBelongsToTenant(tid) && mcIsTenantOwner(tid)) || mcSuperAdminPosDemoSeedDelete();
    }

    match /mc_tenants/{tid}/pos_ventas/{ventaId} {
      allow read: if mcPosOwnerOrVendor(tid) || mcIsSuperAdmin();
      allow create: if (
          mcPosCanWriteVenta(tid)
          && request.resource.data.createdAt is int
        )
        || (mcSuperAdminPosDemoSeedWrite() && request.resource.data.createdAt is int);
      allow update: if mcPosCanWriteVenta(tid)
        && resource.data.get('estado', 'activa') != 'anulada'
        && request.resource.data.estado == 'anulada'
        && request.resource.data.anuladaAt is int
        && request.resource.data.anuladaPorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'anuladaAt', 'anuladaPorUid'])
        || (
          mcPosOwnerOrVendor(tid)
          && resource.data.get('estado', 'activa') != 'anulada'
          && resource.data.get('esContraEntrega', false) == true
          && resource.data.get('estadoPago', 'pendiente') == 'pendiente'
          && request.resource.data.estadoPago == 'pagado'
          && request.resource.data.pagadoAt is int
          && request.resource.data.cobradoPorUid == request.auth.uid
          && request.resource.data.cobradoPorUid is string
          && request.resource.data.cobradoPorUid.size() > 0
          && request.resource.data.cobradoPorNombre is string
          && request.resource.data.pagos is list
          && request.resource.data.pagos.size() == 1
          && request.resource.data.pagos[0].metodo in ['efectivo', 'transferencia', 'nequi']
          && request.resource.data.pagos[0].monto == resource.data.totalCop
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pagos', 'estadoPago', 'pagadoAt', 'cobradoPorUid', 'cobradoPorNombre'])
        );
      allow delete: if mcIsSuperAdmin();
    }

    match /mc_tenants/{tid}/pos_caja_diaria/{cajaId} {
      allow read: if mcPosOwnerOrVendor(tid) || mcIsSuperAdmin();
      allow create, update: if mcPosCanWriteCajaTurno(tid) || mcSuperAdminPosDemoSeedWrite();
      allow delete: if mcSuperAdminPosDemoSeedDelete();
    }

    match /mc_tenants/{tid}/pos_turnos/{turnoId} {
      allow read: if mcPosOwnerOrVendor(tid) || mcIsSuperAdmin();
      allow create, update: if mcPosCanWriteCajaTurno(tid);
      allow delete: if false;
    }

    match /mc_tenants/{tid}/pos_devoluciones/{devolucionId} {
      allow read: if mcPosOwnerOrVendor(tid);
      allow create: if mcPosCanWriteCajaTurno(tid)
        && request.resource.data.createdAt is int;
      allow update, delete: if false;
    }
  }
}
