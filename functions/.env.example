# Secreto para mcOnepayCatalogWebhook y mcSendEmailVerification (Resend): solo la API key.
#   echo -n 're_xxxxx' | firebase functions:secrets:set RESEND_API_KEY
# Remitente en código: Mi Catálogo <notificaciones@micatalogo.io> (functions/src/mcResend.ts).
#
# URL de continuación del enlace de verificación (mismo host que VITE_MC_PUBLIC_ORIGIN en la app web).
# Debe estar en Firebase → Authentication → Dominios autorizados.
# MC_PUBLIC_ORIGIN=https://micatalogo.io
#
# Live shopping (Mux — streaming en vivo):
#   Requiere plan de PAGO en Mux Video (el plan gratuito de Mux no permite live streams).
#   echo -n 'your_mux_token_id' | firebase functions:secrets:set MUX_TOKEN_ID
#   echo -n 'your_mux_token_secret' | firebase functions:secrets:set MUX_TOKEN_SECRET
# Modo demo sin Mux real (stream HLS fijo, sin RTMP):
#   MC_LIVE_USE_MOCK=true
# Streams Mux de prueba (test: true — gratis en plan pago, watermark, ~5 min):
#   MC_MUX_LIVE_TEST=true   ← fallback si no hay muxLiveTestEnabled en mc_platform/settings
#   También editable en Súper admin → «Live shopping — modo Mux» (prioridad sobre esta variable)
# Webhook Mux → mcLiveMuxWebhook (configurar URL en dashboard Mux)
#
# Transmisión desde navegador (LiveKit → RTMP → Mux):
#   echo -n 'wss://your-project.livekit.cloud' | firebase functions:secrets:set LIVEKIT_URL
#   echo -n 'APIxxxxx' | firebase functions:secrets:set LIVEKIT_API_KEY
#   echo -n 'secretxxxxx' | firebase functions:secrets:set LIVEKIT_API_SECRET
# Crear proyecto gratis en https://cloud.livekit.io
