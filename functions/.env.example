# Secreto para mcOnepayCatalogWebhook y mcSendEmailVerification (Resend): solo la API key.
#   echo -n 're_xxxxx' | firebase functions:secrets:set RESEND_API_KEY
# Remitente en código: Mi Catálogo <notificaciones@micatalogo.io> (functions/src/mcResend.ts).
#
# URL de continuación del enlace de verificación (mismo host que VITE_MC_PUBLIC_ORIGIN en la app web).
# Debe estar en Firebase → Authentication → Dominios autorizados.
# MC_PUBLIC_ORIGIN=https://micatalogo.io
