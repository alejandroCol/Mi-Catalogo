{
  "name": "mi-catalogo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:functions": "npm --prefix functions run build",
    "deploy": "bash scripts/deploy.sh",
    "deploy:all": "bash scripts/deploy.sh",
    "deploy:debug": "bash scripts/deploy.sh --debug",
    "deploy:hosting": "bash scripts/deploy.sh --only hosting",
    "deploy:functions": "bash scripts/deploy-functions.sh",
    "deploy:functions:debug": "bash scripts/deploy-functions.sh --debug",
    "deploy:functions:sales": "bash scripts/deploy-functions.sh --only mcCreateSalesRep,mcSetSalesRepActive",
    "deploy:functions:store": "bash scripts/deploy-functions.sh --only mcAdminCreateStore",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:storage": "firebase deploy --only storage"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "clsx": "^2.1.1",
    "firebase": "^12.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  }
}
