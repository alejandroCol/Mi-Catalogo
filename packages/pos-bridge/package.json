{
  "name": "@micatalogo/pos-bridge",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Bridge HTTP local para impresora térmica ESC/POS (Jaltech 58 mm) y cajón SAT 119X",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-scripts.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build:installer": "node scripts/build-installer.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.12.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
