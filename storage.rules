rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    /** exists() antes de get(): doc inexistente tumba toda la condición. */
    function mcUserBelongsToTenant(tenantId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/mc_users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/mc_users/$(request.auth.uid)).data.tenantId == tenantId;
    }

    function mcUserIsSuperAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/mc_users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/mc_users/$(request.auth.uid)).data.isSuperAdmin == true
          || firestore.get(/databases/(default)/documents/mc_users/$(request.auth.uid)).data.isSuperAdmin == 1
        );
    }

    function mcUserImpersonatingTenant(tenantId) {
      return request.auth != null
        && request.auth.token.keys().hasAny(['mcImpersonateTenantId'])
        && request.auth.token.mcImpersonateTenantId == tenantId;
    }

    function mcUserCanAccessTenant(tenantId) {
      return mcUserBelongsToTenant(tenantId)
        || mcUserIsSuperAdmin()
        || mcUserImpersonatingTenant(tenantId);
    }

    function mcUserCanWriteImage(tenantId, maxBytes) {
      return mcUserCanAccessTenant(tenantId)
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function mcUserCanWriteSeasonBanner(tenantId, fileName) {
      return mcUserCanAccessTenant(tenantId)
        && (
          (fileName == 'hero.jpg' && request.resource.size < 6 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
          || (fileName == 'poster.jpg' && request.resource.size < 4 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
          || (fileName == 'hero.mp4' && request.resource.size < 12 * 1024 * 1024 && request.resource.contentType == 'video/mp4')
        );
    }

    /** Imágenes del catálogo (públicas para /catalogo). Escritura solo administrador. */
    match /catalogo/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.role == 'administrador';
    }

    /** Mi Catálogo — fotos de productos por tienda */
    match /mc_tenants/{tenantId}/productos/{fileName} {
      allow read: if true;
      allow write: if mcUserCanAccessTenant(tenantId);
    }

    /** Guías de rastreo (imagen comprimida) — lectura pública opcional */
    match /mc_tenants/{tenantId}/ordenes_catalogo/{fileName} {
      allow read: if true;
      allow write: if mcUserCanWriteImage(tenantId, 4 * 1024 * 1024);
    }

    /** Logo de tienda (plan Expert) */
    match /mc_tenants/{tenantId}/logo/{fileName} {
      allow read: if true;
      allow write: if mcUserCanWriteImage(tenantId, 4 * 1024 * 1024);
    }

    /** Banner temporada fullscreen — imagen (hero.jpg), video (hero.mp4) y poster (poster.jpg) */
    match /mc_tenants/{tenantId}/season_banner/{fileName} {
      allow read: if true;
      allow write: if mcUserCanWriteSeasonBanner(tenantId, fileName);
    }

    match /mc_tenants/{tenantId}/onepay_kyb/{fileName} {
      allow read: if true;
      allow write: if mcUserCanAccessTenant(tenantId)
        && request.resource.size < 16 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
