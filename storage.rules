rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    /** Imágenes del catálogo (públicas para /catalogo). Escritura solo administrador. */
    match /catalogo/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.role == 'administrador';
    }

    /** Mi Catálogo — fotos de productos por tienda */
    match /mc_tenants/{tenantId}/productos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/mc_users/$(request.auth.uid)).data.tenantId == tenantId;
    }

    /** Guías de rastreo (imagen comprimida) — lectura pública opcional */
    match /mc_tenants/{tenantId}/ordenes_catalogo/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/mc_users/$(request.auth.uid)).data.tenantId == tenantId;
    }
  }
}
